{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Edit(migrations/**)",
      "Edit(db/migrate/**)",
      "Edit(.github/workflows/**)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff --stat)"
    ]
  }
}
