{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/file_policy.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-B",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_python.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
